
<%- include("partials/header", { pageTitle: product.name }) %>

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-10">
  <nav class="text-sm text-stone-500 mb-6">
    <a href="/" class="hover:text-teal-800">Home</a> /
    <a href="/shop" class="hover:text-teal-800">Shop</a> /
    <span class="text-stone-800"><%= product.name %></span>
  </nav>

  <div class="grid md:grid-cols-2 gap-8 lg:gap-14">
    <div class="rounded-3xl overflow-hidden bg-stone-100">
      <img src="<%= product.image || 'https://placehold.co/800x1000?text=Fashion' %>" alt="<%= product.name %>" class="w-full max-h-[700px] object-cover">
    </div>
    <div class="py-2">
      <p class="text-xs uppercase tracking-widest font-bold text-teal-800"><%= product.category %></p>
      <h1 class="text-3xl sm:text-4xl font-black mt-3"><%= product.name %></h1>
      <div class="flex items-center gap-3 mt-5">
        <span class="text-2xl font-black"><%= formatMoney(product.price) %></span>
        <% if (product.compare_at && product.compare_at > product.price) { %>
          <span class="text-stone-400 line-through"><%= formatMoney(product.compare_at) %></span>
          <span class="text-xs font-bold bg-orange-100 text-orange-800 px-2 py-1 rounded-full">Special price</span>
        <% } %>
      </div>
      <p class="text-sm mt-5 leading-7 text-stone-600 whitespace-pre-line"><%= product.description %></p>

      <p class="mt-5 text-sm font-semibold <%= product.stock > 0 ? 'text-teal-800' : 'text-red-600' %>">
        <%= product.stock > 0 ? product.stock + " available" : "Currently out of stock" %>
      </p>

      <% if (product.stock > 0) { %>
        <form action="/cart/add" method="POST" class="mt-7 space-y-5">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="product_id" value="<%= product.id %>">

          <div>
            <label for="size" class="block font-bold text-sm mb-2">Choose size</label>
            <select name="size" id="size" required class="w-full border border-stone-300 bg-white rounded-xl p-3">
              <% product.sizes.split(",").map(s => s.trim()).forEach(size => { %>
                <option value="<%= size %>"><%= size %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="color" class="block font-bold text-sm mb-2">Choose color</label>
            <select name="color" id="color" required class="w-full border border-stone-300 bg-white rounded-xl p-3">
              <% product.colors.split(",").map(c => c.trim()).forEach(color => { %>
                <option value="<%= color %>"><%= color %></option>
              <% }) %>
            </select>
          </div>

          <div>
            <label for="quantity" class="block font-bold text-sm mb-2">Quantity</label>
            <input id="quantity" name="quantity" type="number" min="1" max="<%= Math.min(20, product.stock) %>" value="1" required class="border border-stone-300 rounded-xl p-3 w-28">
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button type="submit" class="bg-teal-800 hover:bg-teal-900 text-white rounded-xl px-5 py-4 font-bold">Add to cart</button>
            <button type="submit" name="buy_now" value="1" class="bg-orange-400 hover:bg-orange-300 text-stone-950 rounded-xl px-5 py-4 font-bold">Buy now</button>
          </div>
        </form>
      <% } %>

      <div class="mt-8 border-t pt-5 grid grid-cols-2 gap-4 text-sm">
        <div><p class="font-bold">Payment</p><p class="text-stone-500 mt-1">COD, bKash, Nagad</p></div>
        <div><p class="font-bold">Delivery</p><p class="text-stone-500 mt-1">Across Bangladesh</p></div>
      </div>
    </div>
  </div>

  <% if (related.length) { %>
    <div class="mt-16">
      <h2 class="text-2xl font-black mb-6">You may also like</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <% related.forEach(item => { %>
          <a href="/product/<%= item.id %>" class="group">
            <img src="<%= item.image || 'https://placehold.co/600x750?text=Fashion' %>" alt="<%= item.name %>" class="product-image w-full rounded-2xl bg-stone-100" loading="lazy">
            <p class="font-bold mt-3"><%= item.name %></p>
            <p class="mt-1"><%= formatMoney(item.price) %></p>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>
</section>

<%- include("partials/footer") %>
