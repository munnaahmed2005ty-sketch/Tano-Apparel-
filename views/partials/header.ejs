
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#115e59">
  <title><%= typeof pageTitle !== "undefined" ? pageTitle + " | " + storeName : storeName %></title>
  <meta name="description" content="Shop stylish apparel, T-shirts, shirts, hoodies and everyday fashion in Bangladesh.">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/styles.css">
</head>
<body class="bg-stone-50 text-stone-900 min-h-screen flex flex-col">
<header class="bg-white border-b border-stone-200 sticky top-0 z-40">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="h-16 flex items-center justify-between gap-4">
      <a href="/" class="text-xl sm:text-2xl font-black tracking-tight text-teal-800">
        <%= storeName %><span class="text-orange-500">.</span>
      </a>
      <nav class="flex items-center gap-4 sm:gap-7 text-sm font-semibold">
        <a href="/" class="hover:text-teal-700">Home</a>
        <a href="/shop" class="hover:text-teal-700">Shop</a>
        <a href="/cart" class="hover:text-teal-700">
          Cart <span class="ml-1 bg-teal-800 text-white rounded-full px-2 py-0.5"><%= cartCount %></span>
        </a>
      </nav>
    </div>
  </div>
</header>

<% if (notice) { %>
  <div class="max-w-7xl w-full mx-auto px-4 mt-4">
    <div role="status" class="rounded-xl px-4 py-3 text-sm border <%= notice.type === 'error' ? 'bg-red-50 text-red-800 border-red-200' : 'bg-teal-50 text-teal-900 border-teal-200' %>">
      <%= notice.message %>
    </div>
  </div>
<% } %>

<main class="flex-1">
