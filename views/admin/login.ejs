
<%- include("../partials/header", { pageTitle: "Admin Login" }) %>

<section class="max-w-md mx-auto px-4 py-16">
  <div class="bg-white border border-stone-200 rounded-3xl p-7 sm:p-9 shadow-sm">
    <div class="w-12 h-12 rounded-2xl bg-teal-100 text-teal-900 flex items-center justify-center text-2xl">⌘</div>
    <p class="text-xs uppercase tracking-widest text-teal-800 font-bold mt-6">Store management</p>
    <h1 class="text-3xl font-black mt-2">Admin login</h1>
    <p class="text-sm text-stone-500 mt-2">Sign in to manage products and customer orders.</p>

    <form action="/admin/login" method="POST" class="mt-7 space-y-5">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="username" class="block font-bold text-sm mb-2">Username</label>
        <input id="username" name="username" type="text" maxlength="100" autocomplete="username" required class="w-full border rounded-xl p-3" placeholder="Admin username">
      </div>
      <div>
        <label for="password" class="block font-bold text-sm mb-2">Password</label>
        <input id="password" name="password" type="password" maxlength="200" autocomplete="current-password" required class="w-full border rounded-xl p-3" placeholder="Admin password">
      </div>
      <button type="submit" class="w-full bg-teal-800 hover:bg-teal-900 text-white rounded-xl py-3 font-bold">Sign in securely</button>
    </form>

    <a href="/" class="block text-center mt-6 text-sm text-stone-500 hover:text-teal-800">← Back to storefront</a>
  </div>
</section>

<%- include("../partials/footer") %>
