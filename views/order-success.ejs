
<%- include("partials/header", { pageTitle: "Order Confirmed" }) %>

<section class="max-w-2xl mx-auto px-4 py-20 text-center">
  <div class="mx-auto w-20 h-20 rounded-full bg-teal-100 text-teal-800 flex items-center justify-center text-4xl">✓</div>
  <p class="text-xs uppercase tracking-widest text-teal-800 font-bold mt-7">Order received</p>
  <h1 class="text-3xl sm:text-4xl font-black mt-3">Thank you for shopping!</h1>
  <p class="text-stone-600 mt-4 leading-7">
    Your order has been saved. Keep your order number for reference. Our team will review your order and contact you if needed.
  </p>
  <div class="bg-white border rounded-2xl p-6 mt-7">
    <p class="text-sm text-stone-500">Your order number</p>
    <p class="text-3xl font-black mt-2">#<%= orderId %></p>
  </div>
  <a href="/shop" class="inline-block mt-7 bg-teal-800 hover:bg-teal-900 text-white rounded-xl px-6 py-3 font-bold">Continue shopping</a>
</section>

<%- include("partials/footer") %>
